{
  "name": "vite-plugin-proteus",
  "version": "1.0.0",
  "description": "Vite plugin for Proteus - import Markdown files as structured data",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "keywords": [
    "vite-plugin",
    "markdown",
    "proteus",
    "frontmatter"
  ],
  "author": "Cong Lu",
  "license": "Apache-2.0",
  "peerDependencies": {
    "proteus": "workspace:*",
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "tsup": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
