{
  "name": "vite-plugin-proteus",
  "version": "1.0.0",
  "description": "Vite plugin for Proteus — import Markdown files as structured data",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "keywords": [
    "vite-plugin",
    "markdown",
    "front-matter",
    "proteus",
    "frontmatter",
    "ast"
  ],
  "author": "Cong Lu",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@quill/proteus": ">=1.0.0",
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "tsup": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "publishConfig": {
    "access": "public"
  }
}
