{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["@types/bun"]
  },
  "include": ["src/**/*", "tests/**/*", "cli/**/*", "worker/**/*"],
  "exclude": ["node_modules", "dist", "pkg", "crates"]
}
