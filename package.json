{
  "name": "@quills/proteus",
  "version": "0.1.0",
  "description": "Parse YAML, JSON, and TOML front matter from Markdown files — powered by Rust WASM",
  "type": "module",
  "bin": {
    "proteus": "./cli/index.ts"
  },
  "exports": {
    ".": {
      "workerd": "./src/index.ts",
      "bun": "./src/index.ts",
      "deno": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./extractor": {
      "workerd": "./src/extractor.ts",
      "bun": "./src/extractor.ts",
      "deno": "./src/extractor.ts",
      "default": "./src/extractor.ts"
    },
    "./detector": {
      "workerd": "./src/detector.ts",
      "bun": "./src/detector.ts",
      "deno": "./src/detector.ts",
      "default": "./src/detector.ts"
    },
    "./validator": {
      "workerd": "./src/validator.ts",
      "bun": "./src/validator.ts",
      "deno": "./src/validator.ts",
      "default": "./src/validator.ts"
    }
  },
  "files": [
    "src/",
    "pkg/",
    "cli/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0",
    "deno": ">=2.0"
  },
  "scripts": {
    "build": "bun install",
    "build:wasm": "wasm-pack build crates/parser-wasm --target bundler --out-dir ../../pkg --release",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:deno": "deno test --allow-read --allow-write tests/deno.test.ts",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "rimraf crates/parser-wasm/target pkg",
    "clean:all": "rimraf crates/parser-wasm/target pkg node_modules"
  },
  "keywords": [
    "markdown",
    "frontmatter",
    "front-matter",
    "yaml",
    "json",
    "toml",
    "wasm",
    "parser"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murelux/proteus.git"
  },
  "homepage": "https://github.com/murelux/proteus#readme",
  "bugs": {
    "url": "https://github.com/murelux/proteus/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.9",
    "rimraf": "^6.1.2",
    "tinybench": "^3.0.0",
    "valibot": "^1.0.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.0",
    "wasm-pack": "^0.14.0"
  },
  "peerDependencies": {
    "valibot": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    }
  }
}
