{
  "name": "proteus",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter \"*\" build",
    "build:wasm": "bun run --filter @quill/proteus build:wasm",
    "test": "bun run --filter \"*\" test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "rimraf node_modules packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "rimraf": "latest"
  }
}